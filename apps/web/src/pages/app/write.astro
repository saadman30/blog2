---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WriteForm } from '../../components/backoffice/WriteForm';
---

<BaseLayout title="Write — Back Office">
  <section class="admin-page">
    <h1>Write</h1>
    <WriteForm client:load />
  </section>
</BaseLayout>

<style lang="scss">
  .admin-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: $space-xl $space-lg;
    @include stack($space-md);

    h1 {
      font-family: $font-display;
      margin: 0;
    }
  }
</style>
