---
import '../styles/global.scss';
import { ThemeToggle } from '../components/ThemeToggle';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'PCMS', description = 'Portfolio & Content Management System' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('pcms-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__brand" href="/">PCMS</a>
      <nav class="site-header__nav" aria-label="Primary">
        <a href="/portfolio">Portfolio</a>
        <a href="/blog">Blog</a>
        <a href="/app">Back Office</a>
        <ThemeToggle client:load />
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} PCMS</p>
    </footer>
  </body>
</html>

<style lang="scss">
  .site-header {
    @include theme-surface;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: $space-md;
    padding: $space-md $space-lg;
    border-bottom: 1px solid hsl(var(--border));
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(8px);

    &__brand {
      font-family: $font-display;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    &__nav {
      display: flex;
      align-items: center;
      gap: $space-md;
      font-weight: 600;
    }
  }

  .site-footer {
    padding: $space-lg;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
  }
</style>
